PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payments?schema=public
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=payments_events
# Seconds a cached balance lives in Redis
BALANCE_CACHE_TTL=30
# Seconds an Idempotency-Key is remembered
IDEMPOTENCY_TTL=86400
# Shared secret for verifying inbound webhooks
WEBHOOK_INBOUND_SECRET=change-me
# Outgoing webhook target + signing secret (optional)
WEBHOOK_OUTBOUND_URL=
WEBHOOK_OUTBOUND_SECRET=change-me
WEBHOOK_MAX_ATTEMPTS=5
